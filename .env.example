PORT=3000
NODE_ENV=development

# Base de datos: PostgreSQL es el motor principal. DATABASE_PROVIDER=sqlite
# cambia a la alternativa liviana (usa SQLITE_DATABASE_URL en su lugar), util
# para desarrollo local sin instalar Postgres.
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://paloma:paloma@localhost:5432/paloma_mensajera?schema=public"
SQLITE_DATABASE_URL="file:./dev.db"

JWT_SECRET=change_in_production
JWT_EXPIRES_IN=1d
THROTTLE_TTL=60000
THROTTLE_LIMIT=20
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=paloma.mensajera@example.com
SMTP_PASSWORD=change_in_production

# Acceso institucional - lista separada por coma (profesores vs. estudiantes)
INSTITUTIONAL_EMAIL_DOMAIN=escuelaing.edu.co,mail.escuelaing.edu.co

# Notificacion de entrega
NOTIFICATION_MODE=MANUAL

# Microsoft Graph API (modo automatico) - pendientes de TI de la universidad
GRAPH_TENANT_ID=change_in_production
GRAPH_CLIENT_ID=change_in_production
GRAPH_CLIENT_SECRET=change_in_production
GRAPH_API_SCOPE=https://graph.microsoft.com/.default

# Inicio de sesion con cuenta institucional de Microsoft (Entra ID / Azure AD)
# App registration tipo SPA/publica usada por el frontend (MSAL) para el login
AZURE_AD_TENANT_ID=change_in_production
AZURE_AD_CLIENT_ID=change_in_production

# Semilla del administrador inicial (prisma/seed.ts) - ADMIN_SEED_PASSWORD es
# opcional: sin ella, el admin solo puede iniciar sesion con Microsoft
ADMIN_SEED_EMAIL=admin@escuelaing.edu.co
ADMIN_SEED_PASSWORD=change_in_production

# Cantidad de numeros de rifa a generar en el seed (1..N)
RAFFLE_NUMBER_COUNT=100
