// Prisma schema - Paloma Mensajera (variante PostgreSQL, motor principal)
// SQLite (../sqlite/schema.prisma) queda disponible como alternativa liviana
// para desarrollo local sin instalar nada (ver DATABASE_PROVIDER y
// src/prisma/prisma.service.ts). Ambas variantes deben mantenerse con el
// mismo modelo de datos: los campos "enumerados" se dejan como String (en
// vez de enums nativos de Postgres) para que el cliente generado tenga
// exactamente la misma forma en los dos motores; se validan en la capa de
// aplicacion (DTOs con class-validator) contra los enums de TypeScript en
// src/common/enums.

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id       String           @id @default(uuid())
  slug     String           @unique
  resource String
  action   String
  roles    RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  password    String?
  microsoftId String?   @unique
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now())

  // Auditoria de rotacion de turnos (seccion 6 del SDD): quien y cuando se
  // reasigno por ultima vez el rol de este usuario.
  roleAssignedByAdminId String?
  roleAssignedBy        User?     @relation("RoleAssignedBy", fields: [roleAssignedByAdminId], references: [id])
  roleAssignedAt        DateTime?
  roleReassignments     User[]    @relation("RoleAssignedBy")

  verifiedPayments    PaymentTransaction[] @relation("VerifiedBy")
  deliveryAssignments DeliveryAssignment[] @relation("DeliveryPerson")
  drawRounds          DrawRound[]          @relation("DrawnBy")
  reviewedMessages    MessageReview[]      @relation("ReviewedBy")

  @@map("users")
}

model Product {
  id       String      @id @default(uuid())
  name     String      @unique
  type     String
  price    Float
  stock    Int
  isActive Boolean     @default(true)
  items    OrderItem[]

  @@map("products")
}

model RaffleNumber {
  id            String      @id @default(uuid())
  number        Int         @unique
  status        String      @default("AVAILABLE")
  orderId       String?     @unique
  order         Order?      @relation(fields: [orderId], references: [id])
  drawnAsWinner Boolean     @default(false)
  drawBatchId   String?
  drawnAt       DateTime?
  createdAt     DateTime    @default(now())
  drawRounds    DrawRound[]

  @@map("raffle_numbers")
}

model Order {
  id                 String   @id @default(uuid())
  orderCode          String   @unique
  // Ciclo de vida (seccion 7 del SDD): MESSAGE_PENDING_REVIEW -> MESSAGE_APPROVED
  // -> PAYMENT_PENDING -> ... El pedido nace en revision de mensaje, no en pago.
  status             String   @default("MESSAGE_PENDING_REVIEW")
  // Se calcula recien en selectRaffleNumber (una vez MESSAGE_APPROVED), cuando
  // se descuenta stock del carrito; por eso arranca en 0.
  totalAmount        Float    @default(0)
  salesChannel       String
  assistedBySellerId String?
  createdAt          DateTime @default(now())

  items               OrderItem[]
  deliveryDetail      DeliveryDetail?
  messageReview       MessageReview?
  paymentTransaction  PaymentTransaction?
  raffleNumber        RaffleNumber?
  deliveryAssignments DeliveryAssignment[]
  drawRounds          DrawRound[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  // Se completa en selectRaffleNumber con el precio vigente del producto en
  // ese momento; en la creacion del pedido (revision de mensaje) aun no se
  // conoce, porque el carrito todavia no descuenta stock.
  unitPrice Float   @default(0)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// Doble verificacion de la dedicatoria (seccion 2 y 7.1 del SDD): materializa
// el filtro automatico (siempre aprobado si el pedido llego a existir) y,
// sobre todo, la revision humana final que hace el Verificador y que es la
// que realmente habilita el mapa de rifa.
model MessageReview {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  automaticFilterMethod String
  automaticFilterPassed Boolean   @default(true)
  humanReviewStatus     String    @default("PENDING")
  reviewedByUserId      String?
  reviewedByUser        User?     @relation("ReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt            DateTime?
  rejectionReason       String?

  @@map("message_reviews")
}

model DeliveryDetail {
  id                      String  @id @default(uuid())
  orderId                 String  @unique
  order                   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerName               String
  buyerEmail              String
  buyerPhone              String
  recipientName           String
  recipientTeamsUser      String
  letterContent           String
  isAnonymous             Boolean @default(false)
  contentModerationMethod String
  teamsNotificationSent   Boolean @default(false)
  teamsGraphMessageId     String?

  @@map("delivery_details")
}

model PaymentTransaction {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod     String    @default("NEQUI")
  verified          Boolean   @default(false)
  verifiedByUserId  String?
  verifiedByUser    User?     @relation("VerifiedBy", fields: [verifiedByUserId], references: [id])
  verifiedAt        DateTime?
  verificationNotes String?

  @@map("payment_transactions")
}

model DeliveryAssignment {
  id                   String    @id @default(uuid())
  orderId              String
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPersonId     String
  deliveryPerson       User      @relation("DeliveryPerson", fields: [deliveryPersonId], references: [id])
  status               String    @default("IN_ROUTE")
  assignedAt           DateTime  @default(now())
  deliveredAt          DateTime?
  receivedBy           String?
  teamsConfirmationLog String?
  notes                String?

  @@map("delivery_assignments")
}

model DrawRound {
  id             String       @id @default(uuid())
  drawBatchId    String
  raffleNumberId String
  raffleNumber   RaffleNumber @relation(fields: [raffleNumberId], references: [id])
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  drawnAt        DateTime     @default(now())
  drawnByAdminId String
  drawnByAdmin   User         @relation("DrawnBy", fields: [drawnByAdminId], references: [id])

  @@map("draw_rounds")
}

model AppSettings {
  id               String @id @default("singleton")
  notificationMode String @default("MANUAL")

  @@map("app_settings")
}
